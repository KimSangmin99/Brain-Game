# Server-only variables. Never prefix these with NEXT_PUBLIC_.
# Vercel runtime: Supabase transaction pooler URI from Connect (port 6543).
DATABASE_URL=
# Migration runner only: direct or session pooler URI (port 5432).
DIRECT_DATABASE_URL=
# Optional trusted PEM CA supplied by the database provider, if required.
DATABASE_CA_CERT=
# Future authenticated cron jobs; no cron endpoint is exposed yet.
CRON_SECRET=

# Optional exact canonical origin for mutation checks (no trailing slash).
APP_ORIGIN=
