{
  "name": "brain-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.ts",
    "test:db": "vitest run src/db",
    "db:baseline": "node --experimental-strip-types scripts/db-baseline.ts"
  },
  "dependencies": {
    "@next/env": "16.4.5",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "idb": "8.0.4",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "fake-indexeddb": "6.2.7",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
